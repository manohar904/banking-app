# Copy this file to .env and fill it in to get alerts by email. .env stays out of Git.
# Then run: docker compose --profile monitoring up -d alertmanager

# Where alerts are sent. Leave empty to turn emails off.
ALERT_EMAIL_TO=

# The account that sends them. For Gmail, ALERT_SMTP_PASSWORD must be an app password, not your
# normal password: https://myaccount.google.com/apppasswords (needs 2-step verification).
# Enter it without spaces. If it contains a $, put it in 'single quotes'.
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=

# Only needed if you do not use Gmail.
#ALERT_SMTP_HOST=smtp.gmail.com:587
#ALERT_EMAIL_FROM=

# "Forgot password" emails are sent from the account above. The address the links point to:
#APP_BASE_URL=https://localhost:8443
# Only needed if you do not use Gmail.
#PASSWORD_RESET_SMTP_HOST=smtp.gmail.com
#PASSWORD_RESET_SMTP_PORT=587

# Database backups (see README.md, "Backups"). The defaults are shown.
#BACKUP_TIME=02:00
#BACKUP_TIMEZONE=UTC     for example Asia/Kolkata
#BACKUP_KEEP=7
#BACKUP_DIR=./backups    a folder on another disk is safer

# The most a customer may send by transfer in one day, over all their accounts. Staff have no limit.
# The day starts at midnight in the time zone given. The defaults are shown.
#CUSTOMER_DAILY_TRANSFER_LIMIT=1000.00
#TRANSFER_LIMIT_TIMEZONE=UTC     for example Asia/Kolkata

# Interest on new loans, in percent a year. Existing loans keep the rate they were given.
#LOAN_ANNUAL_INTEREST_RATE=9.50

# Interest on card statements not paid in full, in percent a year (charged monthly).
#CARD_ANNUAL_INTEREST_RATE=19.90

# Each service's own database login (see README.md, "Database logins"). Local defaults are used if
# these are not set. Changing one takes effect at the next `docker compose up -d`.
#CUSTOMER_DB_PASSWORD=
#ACCOUNT_DB_PASSWORD=
#AUTH_DB_PASSWORD=
# The owners of those databases, used only to run migrations.
#CUSTOMER_DB_OWNER_PASSWORD=
#ACCOUNT_DB_OWNER_PASSWORD=
#AUTH_DB_OWNER_PASSWORD=

# Failed sign-ins allowed from one browser address in 15 minutes (see README.md, "Sign-in limits").
#SIGN_IN_MAX_FAILURES_PER_ADDRESS=20
# Only behind a proxy that is the only way in: read the browser's address from X-Forwarded-For.
#GATEWAY_FORWARD_HEADERS=native

# Sign-ins for Kafka and Elasticsearch (see README.md, "Events and monitoring"). Local defaults are
# used if these are not set. The Elasticsearch ones must not contain " or \.
#KAFKA_ADMIN_PASSWORD=
#KAFKA_BANK_PASSWORD=
#KAFKA_FILEBEAT_PASSWORD=
#KAFKA_LOGSTASH_PASSWORD=
#ELASTIC_PASSWORD=          you sign in to Kibana as "elastic" with this
#KIBANA_SYSTEM_PASSWORD=
#LOGSTASH_ES_PASSWORD=
#GRAFANA_ES_PASSWORD=
